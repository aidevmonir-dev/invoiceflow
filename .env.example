# Copy to .env and fill in. Never commit the real .env.

# Required in production: a long random string.
SECRET_KEY=
# 1 for local development only.
DEBUG=0
ALLOWED_HOSTS=invoices.example.com
CSRF_TRUSTED_ORIGINS=https://invoices.example.com

# Claude API key from https://platform.claude.com/ . Without it the app still runs:
# the samples show their stored values and uploads can be entered by hand.
ANTHROPIC_API_KEY=
# Any current Claude model. claude-haiku-5-5 is the cheapest for a public demo.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Demo limits (defaults shown).
EXTRACTIONS_PER_IP_PER_DAY=15
EXTRACTIONS_PER_DAY_TOTAL=200
MAX_PAGES=10
RETENTION_HOURS=24
